       <item row="1" column="0" colspan="2">
        <widget class="QGroupBox" name="gbLiveCQ">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="title">
          <string>Upload decodes to LiveCQ</string>
         </property>
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Master switch for LiveCQ spotting: each CQ decode is uploaded to every enabled destination.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="checkable">
          <bool>true</bool>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
         <layout class="QGridLayout" name="gridLayout_3">
          <item row="0" column="0" colspan="2">
           <layout class="QHBoxLayout" name="hlLiveCQW3SZ">
            <item>
             <widget class="QCheckBox" name="cbLiveCQOfficial">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Send CQ spots to the W3SZ LiveCQ at w3sz.com.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>W3SZ (w3sz.com)</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
            </item>
            <item>
             <widget class="QComboBox" name="cbLiveCQW3SZAppId">
              <property name="toolTip">
               <string>Program name reported to w3sz.com: QMAP, as before the re-branding, or WSMAP. N6NU and custom destinations always receive WSMAP.</string>
              </property>
              <item>
               <property name="text">
                <string>QMAP</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>WSMAP</string>
               </property>
              </item>
             </widget>
            </item>
           </layout>
          </item>
          <item row="1" column="0" colspan="2">
           <widget class="QCheckBox" name="cbLiveCQN6NU">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Send CQ spots to LiveCQ at livecq.n6nu.org.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>N6NU (livecq.n6nu.org)</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QCheckBox" name="cbLiveCQCustom">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Send CQ spots to your own LiveCQ endpoint. Does nothing while the URL field is empty.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string>Custom:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="otherUrlBox">
            <property name="toolTip">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Full URL of your own LiveCQ endpoint, e.g. http://localhost:3000/api/livecq_update&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="text">
             <string/>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item row="2" column="0" colspan="2">
        <widget class="QCheckBox" name="cbSpotPSK">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Send the stations WS-MAP decodes, with your callsign and grid, to PSK Reporter (pskreporter.info). Only live decodes that carry a locator or a CQ are sent, never decodes from recorded files. Needs My Call and My Grid.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Spot decodes to PSK Reporter</string>
         </property>
        </widget>
       </item>
       <item row="3" column="0" colspan="2">
        <widget class="QCheckBox" name="cbSpotPSKTcpIp">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Send the spots to PSK Reporter over a TCP/IP connection instead of UDP datagrams. Try this when spots do not reach PSK Reporter, for example behind a firewall that blocks UDP.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Use TCP/IP for PSK Reporter</string>
         </property>
        </widget>
       </item>
